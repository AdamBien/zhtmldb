#!/usr/bin/env -S java --source 25

import module java.xml;

/// CLI facade: argument parsing, command dispatch, usage hints and status output.
interface Boundary {

    String TOOL = "zhtmldb";
    String NAME = MethodHandles.lookup().lookupClass().getEnclosingClass().getName();
    String VERSION = "2026-09-22.1";

    /// A parsed command line: the table, the command word and the arguments past
    /// them — so commands count their parameters from zero instead of skipping
    /// the leading words over and over.
    record Invocation(String table, String command, List<String> parameters) {}

    static void run(String... args) throws Exception {
        Log.system(NAME + " " + VERSION);
        var arguments = tableQualified(args);
        if (arguments.length == 0) {
            help();
            System.exit(1);
        }
        switch (arguments[0]) {
            case "-help" -> help();
            case "-version" -> {}
            case "tables" -> printLines(Control.tableNames());
            default -> dispatch(arguments);
        }
    }

    /// Turns a symlink persona into a dedicated CLI: a script invoked under a
    /// table's name (busybox-style) has that name as its implicit class, so the
    /// table is prepended to the arguments. The real [#TOOL] name and any leading
    /// flag bypass this.
    static String[] tableQualified(String... args) {
        if (NAME.equals(TOOL) || args.length == 0 || args[0].startsWith("-")) {
            return args;
        }
        return Stream.concat(Stream.of(NAME), Stream.of(args)).toArray(String[]::new);
    }

    static void dispatch(String... args) throws Exception {
        var table = args[0];
        Control.validate(table, "table");
        if (args.length < 2) {
            fail("missing command, see: " + NAME + " -help");
        }
        var invocation = new Invocation(table, args[1], List.of(args).subList(2, args.length));
        switch (invocation.command()) {
            case "set" -> set(invocation);
            case "add" -> add(invocation);
            case "get" -> get(invocation);
            case "rm" -> rm(invocation);
            case "open" -> open(invocation);
            case "keys" -> printLines(Control.keys(table));
            case "list" -> printLines(Control.listing(table, invocation.parameters()));
            case "find" -> find(invocation);
            case "columns" -> columns(invocation);
            default -> fail("unknown command: " + invocation.command());
        }
    }

    /// Merges fields into an existing record (creating it if absent). Three input
    /// shapes, tried in order: a lone comma-bearing argument is positional CSV by
    /// column order, a lone bare name reads its value from stdin, otherwise each
    /// argument is a `field=value` pair. A `+` before the `=` — or after a lone
    /// name — appends instead of replacing. The key may be abbreviated, as long as
    /// it singles out one record; an abbreviation matching none is taken as the key
    /// of a new record.
    static void set(Invocation invocation) throws Exception {
        var parameters = invocation.parameters();
        if (parameters.size() < 2) {
            fail("usage: " + NAME + " <table> set <key> <field>[+]=<value>... | <field>[+] (value from stdin), + appends");
        }
        var table = invocation.table();
        Control.validate(parameters.getFirst(), "key");
        var key = Control.resolvedOrNewKey(table, parameters.getFirst());
        var record = Control.record(table, key);
        var assignments = parameters.subList(1, parameters.size());
        if (assignments.size() == 1 && !assignments.getFirst().contains("=") && assignments.getFirst().contains(",")) {
            record.putAll(Control.positionalFields(table, assignments.getFirst()));
        } else if (assignments.size() == 1 && !assignments.getFirst().contains("=")) {
            var lone = assignments.getFirst();
            var appending = lone.endsWith("+");
            var field = appending ? lone.substring(0, lone.length() - 1) : lone;
            Control.assign(record, field, new String(System.in.readAllBytes(), StandardCharsets.UTF_8).strip(), appending);
        } else {
            for (var assignment : assignments) {
                var separator = assignment.indexOf('=');
                if (separator < 1) {
                    fail("expected <field>=<value> or <field>+=<value>, got: " + assignment);
                }
                var appending = assignment.charAt(separator - 1) == '+';
                var field = assignment.substring(0, appending ? separator - 1 : separator);
                Control.assign(record, field, assignment.substring(separator + 1), appending);
            }
        }
        Control.saveRecord(table, key, record);
        Log.success("stored: " + table + "/" + key + Control.PAGE_SUFFIX);
    }

    /// Appends a record under a generated timestamp key. Each value is a separate
    /// shell argument (not CSV), so field values may themselves contain commas.
    static void add(Invocation invocation) throws Exception {
        var table = invocation.table();
        if (invocation.parameters().isEmpty()) {
            fail("usage: " + commandPrefix(table) + " add <value>...");
        }
        var key = Control.generatedKey(table);
        Control.saveRecord(table, key, Control.positionalFields(table, invocation.parameters()));
        Log.success("added: " + table + "/" + key + Control.PAGE_SUFFIX);
    }

    /// Prints a record, or one of its fields. The key may be abbreviated — a
    /// timestamp key is tedious to type in full — as long as the abbreviation
    /// singles out one record.
    static void get(Invocation invocation) throws Exception {
        var parameters = invocation.parameters();
        if (parameters.isEmpty()) {
            fail("usage: " + NAME + " <table> get <key> [field]");
        }
        var record = Control.existingRecord(invocation.table(), Control.resolveKey(invocation.table(), parameters.getFirst()));
        if (parameters.size() > 1) {
            var value = record.get(parameters.get(1));
            if (value == null) {
                fail("no such field: " + parameters.get(1));
            }
            IO.println(value);
        } else {
            printLines(Control.recordLines(Control.ordered(Control.columnNames(invocation.table()), record)));
        }
    }

    /// Removes a record, or one of its fields. The key may be abbreviated, as long
    /// as it singles out one record.
    static void rm(Invocation invocation) throws Exception {
        var parameters = invocation.parameters();
        if (parameters.isEmpty()) {
            fail("usage: " + NAME + " <table> rm <key> [field]");
        }
        var table = invocation.table();
        var key = Control.resolveKey(table, parameters.getFirst());
        if (parameters.size() > 1) {
            var record = Control.existingRecord(table, key);
            if (record.remove(parameters.get(1)) == null) {
                fail("no such field: " + parameters.get(1));
            }
            Control.saveRecord(table, key, record);
            Log.success("removed: " + parameters.get(1) + " from " + table + "/" + key + Control.PAGE_SUFFIX);
        } else {
            Control.deleteRecord(table, key);
            Log.success("removed: " + table + "/" + key + Control.PAGE_SUFFIX);
        }
    }

    /// Opens a record's page with the platform's default application — usually the
    /// browser, since the page is the UI as much as the storage. The key may be
    /// abbreviated, as long as it singles out one record.
    static void open(Invocation invocation) throws Exception {
        var parameters = invocation.parameters();
        var table = invocation.table();
        if (parameters.isEmpty()) {
            fail("usage: " + commandPrefix(table) + " open <key>");
        }
        var key = Control.resolveKey(table, parameters.getFirst());
        Control.openWithDefaultApplication(Control.recordPage(table, key));
        Log.success("opened: " + table + "/" + key + Control.PAGE_SUFFIX);
    }

    /// Filters a table, printing key<TAB>label so a hit says what it is rather than
    /// only when it was written. Same terms as `list`, different output: `find` is
    /// the pipeable one.
    static void find(Invocation invocation) throws Exception {
        var table = invocation.table();
        if (invocation.parameters().isEmpty()) {
            fail("usage: " + commandPrefix(table) + " find <text> | <field>=<text> ...");
        }
        var columns = Control.columnNames(table);
        printLines(Control.matching(table, invocation.parameters()).entrySet().stream()
                .map(entry -> entry.getKey() + "\t" + Control.label(columns, entry.getValue(), entry.getKey()))
                .toList());
    }

    /// Defines (or, without arguments, prints) the positional column order used by
    /// `set` and `add`, persisting it into the table's generated `index.html`. All
    /// arguments past the command count as one list, since a blank after a comma
    /// makes the shell deliver the names as separate arguments.
    static void columns(Invocation invocation) throws Exception {
        var table = invocation.table();
        if (invocation.parameters().isEmpty()) {
            printLines(Control.columnNames(table).isEmpty()
                    ? List.of()
                    : List.of(String.join(",", Control.columnNames(table))));
            return;
        }
        var columns = invocation.parameters().stream()
                .flatMap(argument -> Stream.of(argument.split(",")))
                .map(String::strip)
                .filter(column -> !column.isEmpty())
                .toList();
        for (var column : columns) {
            Control.validate(column, "field");
        }
        Control.defineColumns(table, columns);
        Log.success("columns for " + table + ": " + String.join(",", columns));
    }

    /// Renders the command prefix for usage hints so a symlink persona shows
    /// `talks add …` rather than the doubled `talks talks add …`.
    static String commandPrefix(String table) {
        return NAME.equals(table) ? NAME : NAME + " " + table;
    }

    static void printLines(List<String> lines) {
        if (!lines.isEmpty()) {
            IO.println(String.join("\n", lines));
        }
    }

    static void fail(String message) {
        Log.error(message);
        System.exit(1);
    }

    static void help() {
        Log.user("""
                Usage: %s <table> <command> [arguments]

                Each record is its own XHTML page (<table>/<key>.html) holding a <dl> of fields.

                Commands:
                  <table> set <key> <field>=<value>...  store fields (merged into the record)
                  <table> set <key> <field>+=<value>... append to fields (newline separated)
                  <table> set <key> <field>             store one field, value from stdin
                  <table> set <key> <field>+            append one field, value from stdin
                  <table> set <key> <v1,v2,...>         store values positionally by table columns
                  <table> add <value>...                add a record with a generated timestamp key
                  <table> columns <name,name,...>       define column order for positional set and add
                  <table> columns                       print the column order
                  <table> get <key>                     print all fields as field<TAB>value lines
                  <table> get <key> <field>             print one field value
                  <table> rm <key>                      remove a record
                  <table> rm <key> <field>              remove one field
                  <table> open <key>                    open the record's page with the default application
                  <table> keys                          print all keys, sorted
                  <table> list [<term>...]              print the records as an aligned table
                  <table> find <term>...                print key<TAB>label for matching records
                  tables                                list all tables
                  -help                                 show this help
                  -version                              show version

                A term filters case-insensitively: <text> matches any field or the key,
                <field>=<text> only that field, <field>= the records having it at all.
                Several terms narrow each other - every one of them has to match.

                A <key> may be abbreviated in set, get, rm and open: an exact key wins, otherwise
                it is a case-insensitive substring and has to match exactly one record - an
                ambiguous abbreviation is an error. For set, matching none means a new record.

                Table, key and field names: letters, digits, _ and - ('index' is a reserved table/key name)

                A symlink named after a table becomes a dedicated CLI with its own configuration:
                  ln -s %s talks && talks add "Java 25" "notes"

                Configuration (zcfg): db.dir sets the database root (default: current directory)
                  ~/.%s/app.properties, ./app.properties, or -Ddb.dir=<path>
                """.formatted(NAME, TOOL, NAME));
    }

    // zcl (https://github.com/AdamBien/zcl), trimmed; SYSTEM and SUCCESS write to
    // stderr here so stdout stays pure data for piping
    enum Log {

        ERROR(Color.RED, System.err),
        USER(Color.CYAN, System.out),
        SYSTEM(Color.BLUE, System.err),
        SUCCESS(Color.MAGENTA, System.err);

        private PrintStream out;

        enum Color {
            RED("\033[38;2;220;50;47m"),          // Solarized Red #dc322f
            MAGENTA("\033[38;2;211;54;130m"),     // Solarized Magenta #d33682
            BLUE("\033[38;2;38;139;210m"),        // Solarized Blue #268bd2
            CYAN("\033[38;2;42;161;152m");        // Solarized Cyan #2aa198

            String code;

            Color(String code) {
                this.code = code;
            }
        }

        private final String value;
        private final static String RESET = "\u001B[0m";

        private Log(Color color, PrintStream out) {
            this.value = (color.code + "%s" + RESET);
            this.out = out;
        }

        String formatted(String raw) {
            return this.value.formatted(raw);
        }

        void out(String message) {
            var colored = formatted(message);
            this.out.println(colored);
        }

        public static void error(String message) {
            Log.ERROR.out(message);
        }

        public static void user(String message) {
            Log.USER.out(message);
        }

        public static void system(String message) {
            Log.SYSTEM.out(message);
        }

        public static void success(String message) {
            Log.SUCCESS.out(message);
        }
    }
}

/// Stateless record, index and rendering functions owning all file I/O.
interface Control {

    String INDEX_PAGE = "index.html";
    String PAGE_SUFFIX = ".html";
    String PROPERTIES_FILE = "app.properties";
    String KEY_COLUMN = "key";
    String COLUMN_GAP = "  ";
    int MAX_CELL = 40;
    Path DB_DIR = Path.of(configuration().getProperty("db.dir", "."));

    /// Serialises the record to its XHTML page and regenerates the affected table
    /// and root index navigation so the browsable site stays consistent.
    static void saveRecord(String table, String key, SortedMap<String, String> record) throws Exception {
        Files.createDirectories(DB_DIR.resolve(table));
        var definitions = ordered(columnNames(table), record).entrySet().stream()
                .map(entry -> "    <dt>%s</dt>\n    <dd>%s</dd>".formatted(escape(entry.getKey()), escape(entry.getValue())))
                .collect(Collectors.joining("\n"));
        var list = record.isEmpty() ? "  <dl></dl>" : "  <dl>\n%s\n  </dl>".formatted(definitions);
        atomicWrite(recordPage(table, key), page(key, breadcrumb(INDEX_PAGE, table), list + "\n" + updatedFooter()));
        updateTableIndex(table);
        updateRootIndex();
    }

    /// The record's stored fields, or an empty record when the page does not exist
    /// yet — `set` merges into either.
    static SortedMap<String, String> record(String table, String key) throws Exception {
        var page = recordPage(table, key);
        return Files.exists(page) ? fields(page) : new TreeMap<>();
    }

    /// The record's stored fields; a missing page ends the command, since `get`
    /// and field removal only make sense on an existing record.
    static SortedMap<String, String> existingRecord(String table, String key) throws Exception {
        var page = recordPage(table, key);
        if (!Files.exists(page)) {
            Boundary.fail("no such key: " + key);
        }
        return fields(page);
    }

    /// Resolves a possibly abbreviated key to a stored one for the commands reading
    /// or removing a record: an abbreviation matching nothing is a miss, since
    /// `get` and `rm` only make sense on an existing record.
    static String resolveKey(String table, String key) throws Exception {
        var resolved = resolvedOrNewKey(table, key);
        if (!Files.exists(recordPage(table, resolved))) {
            Boundary.fail("no such key: " + key);
        }
        return resolved;
    }

    /// Resolves a possibly abbreviated key to a stored one: an exact key always
    /// wins, otherwise the key is taken as a case-insensitive substring and has to
    /// single out one record. Several hits end the command listing them — picking
    /// one of them would be a guess about which record was meant. An abbreviation
    /// matching nothing stays the key it is, so `set` still creates a record under
    /// a key not stored yet.
    static String resolvedOrNewKey(String table, String key) throws Exception {
        if (Files.exists(recordPage(table, key)) || !Files.isDirectory(DB_DIR.resolve(table))) {
            return key;
        }
        var matches = keys(table).stream()
                .filter(candidate -> candidate.toLowerCase().contains(key.toLowerCase()))
                .toList();
        if (matches.size() > 1) {
            Boundary.fail("ambiguous key: %s matches %s".formatted(key, String.join(", ", matches)));
        }
        return matches.isEmpty() ? key : matches.getFirst();
    }

    static void deleteRecord(String table, String key) throws Exception {
        var page = recordPage(table, key);
        if (!Files.exists(page)) {
            Boundary.fail("no such key: " + key);
        }
        Files.delete(page);
        updateTableIndex(table);
        updateRootIndex();
    }

    /// Persists the positional column order into the table's generated
    /// `index.html`, creating the table folder on first use.
    static void defineColumns(String table, List<String> columns) throws Exception {
        Files.createDirectories(DB_DIR.resolve(table));
        updateTableIndex(table, columns);
        updateRootIndex();
    }

    /// Builds a sortable second-resolution timestamp key, suffixing `-2`, `-3`… on
    /// same-second collisions so a rapid burst of adds never silently overwrites.
    static String generatedKey(String table) {
        var timestamp = LocalDateTime.now().format(DateTimeFormatter.ofPattern("yyyy-MM-dd-HHmmss"));
        var key = timestamp;
        for (var counter = 2; Files.exists(recordPage(table, key)); counter++) {
            key = timestamp + "-" + counter;
        }
        return key;
    }

    /// Replaces a field's value, or appends to it. Appending joins with a newline
    /// so a field grows into a readable log rather than one run-on line; a missing
    /// or blank field takes the value as is, making `+=` safe as the first write.
    static void assign(SortedMap<String, String> record, String field, String value, boolean appending) {
        validate(field, "field");
        var existing = record.get(field);
        record.put(field, !appending || existing == null || existing.isBlank() ? value : existing + "\n" + value);
    }

    /// CSV overload for `set`: splits on commas with a `-1` limit so trailing empty
    /// values still map to their columns.
    static SortedMap<String, String> positionalFields(String table, String csv) throws Exception {
        return positionalFields(table, List.of(csv.split(",", -1)));
    }

    /// Maps values onto the table's declared columns by position; requires columns
    /// to be defined and rejects more values than there are columns.
    static SortedMap<String, String> positionalFields(String table, List<String> values) throws Exception {
        var columns = columnNames(table);
        if (columns.isEmpty()) {
            Boundary.fail("no columns defined, run: " + Boundary.commandPrefix(table) + " columns <name,name,...>");
        }
        if (values.size() > columns.size()) {
            Boundary.fail("%d values but only %d columns: %s".formatted(values.size(), columns.size(), String.join(",", columns)));
        }
        var record = new TreeMap<String, String>();
        for (var index = 0; index < values.size(); index++) {
            record.put(columns.get(index), values.get(index).strip());
        }
        return record;
    }

    /// Reads the declared column order from the `<code>` element that
    /// [Boundary#columns] writes into the table's `index.html`.
    static List<String> columnNames(String table) throws Exception {
        var index = DB_DIR.resolve(table).resolve(INDEX_PAGE);
        if (!Files.exists(index)) {
            return List.of();
        }
        var codes = parse(index).getElementsByTagName("code");
        if (codes.getLength() == 0) {
            return List.of();
        }
        return Stream.of(codes.item(0).getTextContent().split(","))
                .map(String::strip)
                .toList();
    }

    /// Renders the table as one row per record — a record spread over one line per
    /// field is unreadable past a handful of records. Filter terms narrow it to the
    /// matching records, in [Boundary#find]'s syntax. Aligned for reading rather
    /// than piping; `keys`, `get` and `find` stay tab separated.
    static List<String> listing(String table, List<String> terms) throws Exception {
        var records = matching(table, terms);
        if (records.isEmpty()) {
            return List.of();
        }
        var headers = headers(columnNames(table), records.values());
        var body = records.entrySet().stream().map(entry -> row(entry.getKey(), headers, entry.getValue()));
        return aligned(Stream.concat(Stream.of(headers), body).toList());
    }

    /// Table columns: the key, then the declared columns, then any remaining field
    /// names the records carry, sorted. Declared columns appear even when empty —
    /// the schema, not the data, defines the table's shape.
    static List<String> headers(List<String> columns, Collection<SortedMap<String, String>> records) {
        var extras = records.stream().flatMap(record -> record.keySet().stream()).sorted();
        return Stream.of(Stream.of(KEY_COLUMN), columns.stream(), extras)
                .flatMap(Function.identity())
                .distinct()
                .toList();
    }

    static List<String> row(String key, List<String> headers, SortedMap<String, String> record) {
        return headers.stream()
                .map(header -> header.equals(KEY_COLUMN) ? key : cell(record.getOrDefault(header, "")))
                .toList();
    }

    /// Collapses a value onto one line and cuts it at [#MAX_CELL], since a
    /// multi-line or long body would otherwise wrap and destroy the layout. The
    /// full value stays available through `get`; keys are never cut, so they remain
    /// usable as `get` arguments.
    static String cell(String value) {
        var single = value.replaceAll("\\s+", " ").strip();
        return single.length() <= MAX_CELL ? single : single.substring(0, MAX_CELL - 1) + "…";
    }

    /// Pads every cell to its column's widest entry, then strips the line end, so
    /// the trailing column needs no special case to avoid trailing whitespace.
    static List<String> aligned(List<List<String>> rows) {
        var widths = IntStream.range(0, rows.getFirst().size())
                .map(column -> rows.stream().mapToInt(row -> row.get(column).length()).max().orElse(0))
                .boxed()
                .toList();
        return rows.stream()
                .map(row -> IntStream.range(0, row.size())
                        .mapToObj(column -> pad(row.get(column), widths.get(column)))
                        .collect(Collectors.joining(COLUMN_GAP))
                        .stripTrailing())
                .toList();
    }

    static String pad(String cell, int width) {
        return cell + " ".repeat(width - cell.length());
    }

    /// Selects the records satisfying every term, in key order — a second term
    /// narrows the first rather than widening it, so a filter reads as a path into
    /// the table. An empty result ends the command with exit code 1: a filter that
    /// matches nothing is a miss, not an empty table. Without terms the whole table
    /// passes, and an empty one stays a success.
    static SequencedMap<String, SortedMap<String, String>> matching(String table, List<String> terms) throws Exception {
        var filters = terms.stream().map(Entity.Filter::of).toList();
        var records = new LinkedHashMap<String, SortedMap<String, String>>();
        for (var key : keys(table)) {
            var record = fields(recordPage(table, key));
            if (filters.stream().allMatch(filter -> filter.matches(record, key))) {
                records.put(key, record);
            }
        }
        if (records.isEmpty() && !filters.isEmpty()) {
            Boundary.fail("no match: " + String.join(" ", terms));
        }
        return records;
    }

    static List<String> recordLines(Map<String, String> record) {
        return record.entrySet().stream()
                .map(entry -> entry.getKey() + "\t" + entry.getValue())
                .toList();
    }

    /// Arranges a record's fields in the table's declared column order, so a page,
    /// `get` and `list` all read in schema order rather than alphabetically. Fields
    /// outside the schema keep their alphabetical order and follow the declared
    /// ones; without declared columns the record stays alphabetical.
    static SequencedMap<String, String> ordered(List<String> columns, SortedMap<String, String> record) {
        var declaredFirst = Stream.concat(columns.stream(), record.keySet().stream()).distinct();
        return declaredFirst
                .filter(record::containsKey)
                .collect(Collectors.toMap(Function.identity(), record::get, (first, _) -> first, LinkedHashMap::new));
    }

    static List<String> keys(String table) throws Exception {
        var folder = DB_DIR.resolve(table);
        if (!Files.isDirectory(folder)) {
            Boundary.fail("no such table: " + table);
        }
        try (var pages = Files.list(folder)) {
            return pages
                    .map(page -> page.getFileName().toString())
                    .filter(Control::isRecordPage)
                    .map(fileName -> fileName.substring(0, fileName.length() - PAGE_SUFFIX.length()))
                    .sorted()
                    .toList();
        }
    }

    static boolean isRecordPage(String fileName) {
        return fileName.endsWith(PAGE_SUFFIX) && !fileName.equals(INDEX_PAGE);
    }

    static List<String> tableNames() throws Exception {
        if (!Files.isDirectory(DB_DIR)) {
            return List.of();
        }
        try (var folders = Files.list(DB_DIR)) {
            return folders
                    .filter(Files::isDirectory)
                    .filter(Control::isTable)
                    .map(folder -> folder.getFileName().toString())
                    .sorted()
                    .toList();
        }
    }

    static boolean isTable(Path folder) {
        return Files.exists(folder.resolve(INDEX_PAGE));
    }

    static Path recordPage(String table, String key) {
        return DB_DIR.resolve(table).resolve(key + PAGE_SUFFIX);
    }

    /// Hands a page to the operating system's opener — `open` on macOS, `xdg-open`
    /// on Linux, `start` on Windows — rather than AWT's Desktop, which would drag a
    /// GUI toolkit (and a dock icon) into a CLI for one launch. The path is made
    /// absolute since the opener resolves relative paths against its own notion of
    /// the working directory.
    static void openWithDefaultApplication(Path page) throws Exception {
        var file = page.toAbsolutePath().normalize().toString();
        var os = System.getProperty("os.name", "").toLowerCase();
        var command = os.contains("mac") ? List.of("open", file)
                : os.contains("win") ? List.of("cmd", "/c", "start", "", file)
                : List.of("xdg-open", file);
        var exit = new ProcessBuilder(command).inheritIO().start().waitFor();
        if (exit != 0) {
            Boundary.fail("could not open: " + file);
        }
    }

    /// Reconstructs a record by pairing `<dt>`/`<dd>` elements — the XHTML page is
    /// both the on-disk storage format and the browsable UI.
    static SortedMap<String, String> fields(Path recordPage) throws Exception {
        var document = parse(recordPage);
        var names = document.getElementsByTagName("dt");
        var values = document.getElementsByTagName("dd");
        var record = new TreeMap<String, String>();
        for (var index = 0; index < Math.min(names.getLength(), values.getLength()); index++) {
            record.put(names.item(index).getTextContent(), values.item(index).getTextContent());
        }
        return record;
    }

    static Document parse(Path page) throws Exception {
        return DocumentBuilderFactory.newInstance().newDocumentBuilder().parse(page.toFile());
    }

    static void updateTableIndex(String table) throws Exception {
        updateTableIndex(table, columnNames(table));
    }

    static void updateTableIndex(String table, List<String> columns) throws Exception {
        var links = new ArrayList<String>();
        for (var key : keys(table)) {
            links.add(link(key + PAGE_SUFFIX, label(table, key, columns)));
        }
        var content = columnsSection(columns) + navigation(String.join("\n", links));
        atomicWrite(DB_DIR.resolve(table).resolve(INDEX_PAGE), page(table, breadcrumb("../" + INDEX_PAGE, Boundary.NAME), content));
    }

    static void updateRootIndex() throws Exception {
        var links = tableNames().stream()
                .map(table -> link(table + "/" + INDEX_PAGE, table))
                .collect(Collectors.joining("\n"));
        atomicWrite(DB_DIR.resolve(INDEX_PAGE), page(Boundary.NAME, "", navigation(links)));
    }

    /// Labels an index entry with the record's first column value: a generated
    /// timestamp key identifies a record but says nothing about it, while the
    /// leading field is what the record is about. Falls back to the key when no
    /// columns are declared or the record has no value for the first one.
    static String label(String table, String key, List<String> columns) throws Exception {
        return label(columns, fields(recordPage(table, key)), key);
    }

    /// Labels an already loaded record, so callers holding its fields —
    /// [Boundary#find] — do not parse the page a second time.
    static String label(List<String> columns, SortedMap<String, String> record, String key) {
        if (columns.isEmpty()) {
            return key;
        }
        var value = record.getOrDefault(columns.getFirst(), "");
        return value.isBlank() ? key : value;
    }

    static String columnsSection(List<String> columns) {
        return columns.isEmpty() ? "" : "  <p>columns: <code>%s</code></p>\n".formatted(escape(String.join(", ", columns)));
    }

    static String link(String href, String label) {
        return "      <li><a href=\"%s\">%s</a></li>".formatted(href, escape(label));
    }

    static String navigation(String links) {
        return links.isEmpty() ? "  <nav><ul></ul></nav>" : "  <nav>\n    <ul>\n%s\n    </ul>\n  </nav>".formatted(links);
    }

    static String page(String title, String breadcrumb, String content) {
        return """
                <!DOCTYPE html>
                <html xmlns="http://www.w3.org/1999/xhtml" lang="en">
                <head>
                  <meta charset="utf-8"/>
                  <title>%s</title>
                  <style>
                    :root { color-scheme: light dark; }
                    body { font-family: system-ui, sans-serif; line-height: 1.6; max-width: 40rem; margin: 2rem auto; padding: 0 1rem; }
                    dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.3rem 1.5rem; }
                    dt { font-weight: 600; }
                    dd { margin: 0; white-space: pre-wrap; }
                    nav ul { list-style: none; padding: 0; }
                    footer { font-size: 0.8rem; opacity: 0.6; }
                  </style>
                </head>
                <body>
                %s<main>
                  <h1>%s</h1>
                %s
                </main>
                </body>
                </html>
                """.formatted(escape(title), breadcrumb, escape(title), content);
    }

    static String breadcrumb(String href, String label) {
        return """
                <header>
                  <nav><a href="%s">↑ %s</a></nav>
                </header>
                """.formatted(href, label);
    }

    static String updatedFooter() {
        var updated = Instant.now().truncatedTo(ChronoUnit.SECONDS);
        return """
                  <footer>
                    <p>updated <time datetime="%s">%s</time></p>
                  </footer>\
                """.formatted(updated, updated);
    }

    /// Writes via a temp file plus `ATOMIC_MOVE` so concurrent readers (browsers,
    /// git) never observe a half-written page.
    static void atomicWrite(Path target, String content) throws Exception {
        var temp = Files.createTempFile(target.getParent(), "." + Boundary.NAME, ".tmp");
        temp.toFile().setReadable(true, false);
        Files.writeString(temp, content);
        Files.move(temp, target, StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING);
    }

    /// Enforces the name grammar and rejects `index` as a table or key name, since
    /// every table folder owns a generated `index.html`.
    static void validate(String identifier, String kind) {
        if (!identifier.matches("[A-Za-z0-9_][A-Za-z0-9_-]*")) {
            Boundary.fail("invalid %s name: %s (allowed: letters, digits, _ and -)".formatted(kind, identifier));
        }
        if (!kind.equals("field") && identifier.equals("index")) {
            Boundary.fail("'index' is a reserved %s name".formatted(kind));
        }
    }

    static String escape(String text) {
        return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;");
    }

    /// Layers configuration global, then local, then system properties, so
    /// `-Ddb.dir` overrides the files. The global path `~/.<name>/` follows the
    /// symlink persona.
    static Properties configuration() {
        var configuration = new Properties();
        var global = Path.of(System.getProperty("user.home"), "." + Boundary.NAME, PROPERTIES_FILE);
        var local = Path.of(PROPERTIES_FILE);
        for (var candidate : List.of(global, local)) {
            if (Files.exists(candidate)) {
                try (var reader = Files.newBufferedReader(candidate)) {
                    configuration.load(reader);
                } catch (IOException error) {
                    throw new UncheckedIOException(error);
                }
            }
        }
        configuration.putAll(System.getProperties());
        return configuration;
    }
}

/// Domain values: filter terms parsed from the command line.
interface Entity {

    /// A case-insensitive substring, optionally scoped to a single field.
    record Filter(String field, String text) {

        static Filter of(String term) {
            var separator = term.indexOf('=');
            return separator < 1
                    ? new Filter(null, term.toLowerCase())
                    : new Filter(term.substring(0, separator), term.substring(separator + 1).toLowerCase());
        }

        /// A field-scoped term matches only that field, and only where the record
        /// actually carries it — so a bare `field=` selects the records having it.
        /// A bare term also matches the key, so a date fragment finds every record
        /// added that day.
        boolean matches(SortedMap<String, String> record, String key) {
            if (this.field != null) {
                var value = record.get(this.field);
                return value != null && value.toLowerCase().contains(this.text);
            }
            return key.toLowerCase().contains(this.text)
                    || record.values().stream().anyMatch(value -> value.toLowerCase().contains(this.text));
        }
    }
}

void main(String... args) throws Exception {
    Boundary.run(args);
}
